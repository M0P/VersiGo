# Dependencies
# BugFix-23: exclude node_modules at EVERY depth – a stale host
# apps/*/node_modules (old lockfile state after a dependency bump) must never
# overwrite the fresh workspace node_modules produced by the deps stage.
node_modules/
**/node_modules/
.pnpm-store/

# Build outputs
# BugFix-23: exclude build outputs at EVERY depth as well. Host artifacts from
# an earlier local build must never enter the build context – the images build
# these directories themselves, and a copied `tsconfig*.tsbuildinfo` from the
# host can make an incremental `tsc` run skip emitting into a stale `dist/`.
dist/
**/dist/
.next/
**/.next/
*.tsbuildinfo
**/*.tsbuildinfo

# Git and version control
.git/
.gitattributes
.gitignore

# Turbo
.turbo/
**/.turbo/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed for build) – except the third-party notices file,
# which the license check inside the test image validates against.
docs/*
!docs/third-party-notices.md
prompts/

# Uploads (runtime data)
uploads/

# Backups
*.bak
*.backup
