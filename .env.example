APP_PORT=3001
WEB_PORT=3000

NODE_ENV=development

POSTGRES_DB=insura
POSTGRES_USER=insura
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://insura:change-me@localhost:5432/insura

REDIS_URL=redis://localhost:6379

STORAGE_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=insura
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me

OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=insura
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
OPENAI_COMPAT_API_KEY=change-me

PAPERLESS_ENABLED=false
PAPERLESS_BASE_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=change-me

# AP2: 32-Byte-Hex-Schluessel (64 Zeichen) fuer AES-256-GCM.
# Erzeugen z. B. via: openssl rand -hex 32
# Niemals im Klartext committen; nur lokal/Secrets-Manager pflegen.
SETTINGS_ENCRYPTION_KEY=change-me-64-char-hex-generate-with-openssl-rand-hex-32-cmd

# AP-02: Server-Session-Secret (express-session). Mind. 32 Zufallszeichen.
# Erzeugen z. B. via: openssl rand -hex 32
# Niemals im Klartext committen; nur lokal/Secrets-Manager pflegen.
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32-cmd
