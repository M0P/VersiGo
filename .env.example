# ============================================================
# VersiGo – Environment Configuration
# ============================================================
# Copy this file to .env and adjust for your environment.
# Never commit .env to version control!
#
# Quick start:
#   cp .env.example .env
#   docker compose up --build
#
# The stack will be available at:
#   Web:  http://localhost:3000
#   API:  http://localhost:3001
#
# AP-17 (Settings-Katalog): Viele fachliche/betriebliche Werte unten sind
# ueber die Admin-UI setzbar ("Systemeinstellungen", /admin/settings) und
# haben dann Vorrang vor diesen .env-Werten – .env bleibt der dokumentierte
# Fallback. Infrastrukturkritische Werte (Datenbank/Redis, Root-Secrets,
# Ports, Pfade, TLS/Proxy, Auth-Boot-Flags) sind ausschliesslich
# Environment/Compose und nie ueber die UI aenderbar.
# Vollstaendiger Katalog: docs/13-settings-catalog.md
# ============================================================

# --- Application -------------------------------------------------
# Entwicklungs-Default. Fuer den Beta-/Produktionsbetrieb zwingend auf
# 'production' stellen: Erst mit NODE_ENV=production gelten die
# Sicherheitsgarantien (kein automatischer Default-Admin, Ablehnung des
# Platzhalter-Passworts, Session-Cookie mit Secure-Flag, Auth-Fail-Fast).
# Siehe docs/docker-image-guide.md Abschnitt 5.
NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000

# Public API base URL for the browser (injected at container startup via entrypoint)
# This allows fully dynamic port configuration without rebuilding the web image
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Next.js dev server: allowed origins for HMR/dev requests
# (comma-separated "host" or "host:port"). Defaults to localhost only;
# extend with your LAN IP, e.g. 192.168.24.8:3000. Dev-only setting.
NEXT_ALLOWED_DEV_ORIGINS=

# AP-16: Express "trust proxy" — nur hinter einem vertrauenswuerdigen
# Reverse-Proxy auf true setzen (X-Forwarded-For wird dann fuer req.ip und
# die per-IP-Rate-Limits von Login/Registrierung herangezogen).
TRUST_PROXY=false

# AP-20: Secure-Flag des Session-Cookies. Default: true in Produktion,
# false sonst (abgeleitet aus NODE_ENV). Nur explizit setzen, wenn die API
# kontrolliert ueber reines HTTP bedient wird (z.B. hinter einem
# TLS-terminierenden Reverse-Proxy oder in einer kontrollierten internen
# Installation) — in allen anderen Faellen ungesetzt lassen.
COOKIE_SECURE=

# AP-16: Erlaubte Browser-Origins fuer CORS (Komma-separierte Liste).
# Die Web-App ruft die API cross-origin mit credentials auf; ohne diesen
# Header blockiert der Browser das Lesen der API-Antworten. Mehrere Origins
# mit Komma trennen, z.B.: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------
POSTGRES_DB=versigo
POSTGRES_USER=versigo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://versigo:change-me@db:5432/versigo

# --- Redis -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Document Storage --------------------------------------------
STORAGE_ENABLED=false
# Path for locally stored documents (mounted volume in Compose)
DOCUMENTS_STORAGE_PATH=/data/uploads

# Optional MinIO/S3 storage (requires the "storage" profile)
S3_ENDPOINT=http://storage:9000
S3_BUCKET=versigo
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me

# --- Local Username/Password Authentication ----------------------
# Default fuer die lokale Entwicklung: aktiv. In Produktion muss die
# Authentifizierung explizit konfiguriert werden (LOCAL_AUTH_ENABLED
# und/oder OIDC_ENABLED); die App startet dort ohne gesetzte Flags
# nicht (Fail-Fast).
LOCAL_AUTH_ENABLED=true
# Max failed attempts before rate limiting kicks in (per IP, per window)
LOCAL_AUTH_MAX_ATTEMPTS=5
# Rate limit window in milliseconds (default: 15 minutes)
LOCAL_AUTH_RATE_LIMIT_WINDOW_MS=900000

# Initial local administrator (created once, when LOCAL_AUTH_ENABLED=true)
# AP-20: In production the bootstrap never runs automatically: an admin is
# created only when LOCAL_AUTH_ENABLED=true AND these two variables are set
# explicitly. The placeholder password below is rejected in production
# (NODE_ENV=production) and must be replaced with a strong, own value.
LOCAL_ADMIN_USERNAME=localadmin
LOCAL_ADMIN_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# --- OIDC Authentication (optional) -------------------------------
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=versigo
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

# --- AI Assist (optional, AP-17: Admin-UI-konfigurierbar) ----------
# UI-Werte in /admin/settings haben Vorrang vor diesen .env-Fallbacks.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
AI_OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
AI_OPENAI_COMPAT_API_KEY=change-me
AI_OPENAI_COMPAT_MODEL=gpt-4o-mini
AI_EXTRACTION_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# --- Paperless-ngx (optional, AP-17: Admin-UI-konfigurierbar) -------
PAPERLESS_ENABLED=false
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=change-me

# --- Worker Health (AP-19) ------------------------------------------
# Minimaler Liveness-Server des Workers (intern, Compose-Healthcheck).
WORKER_HEALTH_PORT=3100
# Intervall (ms), in dem der Worker seinen Heartbeat in PostgreSQL schreibt.
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Timeout (ms) nach dem ein Heartbeat als veraltet gilt (GET /ready der API).
WORKER_HEARTBEAT_TIMEOUT_MS=45000

# --- Secrets (REQUIRED - generate your own!) -----------------------
# Generate with: openssl rand -hex 32
# Never commit real secrets to version control.
# The value below is a development-only placeholder. Replace for production.
SETTINGS_ENCRYPTION_KEY=6fb08ca5c2594034b97f2a50e3011699c5a791bd3711d726092fec455d75ad6c

# Server session secret (express-session). Minimum 32 random characters.
SESSION_SECRET=dev-only-session-secret-32-chars-min!!!
