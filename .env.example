# ============================================================
# VersiGo – Environment Configuration
# ============================================================
# Copy this file to .env and adjust for your environment.
# Never commit .env to version control!
#
# Quick start:
#   cp .env.example .env
#   docker compose up --build
#
# The stack will be available at:
#   Web:  http://localhost:3000
#   API:  http://localhost:3001
#
# AP-17 (settings catalog): Many functional/operational values below can be
# set via the admin UI ("System settings", /admin/settings) and then take
# precedence over these .env values – .env remains the documented fallback.
# Infrastructure-critical values (database/Redis, root secrets, ports, paths,
# TLS/proxy, auth boot flags) are exclusively environment/Compose and can
# never be changed via the UI.
# Full catalog: docs/13-settings-catalog.md
# ============================================================

# --- Application -------------------------------------------------
# Development default. For beta/production operation set to 'production'
# without exception: only with NODE_ENV=production do the security guarantees
# apply (no automatic default admin, rejection of the placeholder password,
# session cookie with Secure flag, auth fail-fast).
# See docs/docker-image-guide.md section 5.
NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000

# Docker Hub deployment (BugFix-09): pin the image tag used by
# docker-compose.dockerhub.yml (deployment from prebuilt Docker Hub images,
# no rebuild). Defaults to `latest` when unset. Not used by the
# build-from-source stack (docker-compose.yml).
# VERSIGO_IMAGE_TAG=1.2.3

# Public API base URL for the browser (injected at container startup via entrypoint)
# This allows fully dynamic port configuration without rebuilding the web image
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Next.js dev server: allowed origins for HMR/dev requests
# (comma-separated "host" or "host:port"). Defaults to localhost only;
# extend with your LAN IP, e.g. 192.168.24.8:3000. Dev-only setting.
NEXT_ALLOWED_DEV_ORIGINS=

# AP-16: Express "trust proxy" — only set to true behind a trusted reverse
# proxy (X-Forwarded-For is then used for req.ip and the per-IP rate limits
# of login/registration).
TRUST_PROXY=false

# AP-20: Secure flag of the session cookie. Default: true in production,
# false otherwise (derived from NODE_ENV). Only set explicitly when the API
# is served deliberately over plain HTTP (e.g. behind a TLS-terminating
# reverse proxy or in a controlled internal installation) — leave unset in
# all other cases.
COOKIE_SECURE=

# AP-16: Allowed browser origins for CORS (comma-separated list).
# The web app calls the API cross-origin with credentials; without this
# header the browser blocks reading API responses. Separate multiple origins
# with commas, e.g.: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------
POSTGRES_DB=versigo
POSTGRES_USER=versigo
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://versigo:change-me@db:5432/versigo

# --- Redis -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Document Storage --------------------------------------------
STORAGE_ENABLED=false
# Path for locally stored documents (mounted volume in Compose)
DOCUMENTS_STORAGE_PATH=/data/uploads

# Optional MinIO/S3 storage (requires the "storage" profile)
S3_ENDPOINT=http://storage:9000
S3_BUCKET=versigo
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me

# --- Local Username/Password Authentication ----------------------
# Default for local development: enabled. In production, authentication must
# be configured explicitly (LOCAL_AUTH_ENABLED and/or OIDC_ENABLED); without
# any set flag the app does not start there (fail-fast).
LOCAL_AUTH_ENABLED=true
# Max failed attempts before rate limiting kicks in (per IP, per window)
LOCAL_AUTH_MAX_ATTEMPTS=5
# Rate limit window in milliseconds (default: 15 minutes)
LOCAL_AUTH_RATE_LIMIT_WINDOW_MS=900000

# Initial local administrator (created once, when LOCAL_AUTH_ENABLED=true)
# AP-20: In production the bootstrap never runs automatically: an admin is
# created only when LOCAL_AUTH_ENABLED=true AND these two variables are set
# explicitly. The placeholder password below is rejected in production
# (NODE_ENV=production) and must be replaced with a strong, own value.
LOCAL_ADMIN_USERNAME=localadmin
LOCAL_ADMIN_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT

# --- OIDC Authentication (optional) -------------------------------
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=versigo
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

# --- AI Assist (optional, AP-17: configurable via admin UI) ----------
# UI values in /admin/settings take precedence over these .env fallbacks.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
AI_OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
AI_OPENAI_COMPAT_API_KEY=change-me
AI_OPENAI_COMPAT_MODEL=gpt-4o-mini
AI_EXTRACTION_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# --- Paperless-ngx (optional, AP-17: configurable via admin UI) -------
PAPERLESS_ENABLED=false
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=change-me

# --- Connectivity (BugFix-06, optional, configurable via admin UI) ----
# SSRF relaxation for local/private endpoints and self-signed TLS
# certificates. Both are deliberately opt-in and OFF by default
# (strict SSRF protection: only public http(s) endpoints). The
# cloud metadata address 169.254.169.254 stays blocked even when the
# option is enabled.
# CONNECTIVITY_ALLOW_PRIVATE_ENDPOINTS=false
# CONNECTIVITY_ALLOW_SELF_SIGNED=false

# --- Worker Health (AP-19) ------------------------------------------
# Minimal liveness server of the worker (internal, Compose healthcheck).
WORKER_HEALTH_PORT=3100
# Interval (ms) in which the worker writes its heartbeat to PostgreSQL.
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Timeout (ms) after which a heartbeat is considered stale (GET /ready of the API).
WORKER_HEARTBEAT_TIMEOUT_MS=45000

# --- Secrets (REQUIRED - generate your own!) -----------------------
# Generate with: openssl rand -hex 32
# Never commit real secrets to version control.
# The value below is a development-only placeholder. Replace for production.
SETTINGS_ENCRYPTION_KEY=6fb08ca5c2594034b97f2a50e3011699c5a791bd3711d726092fec455d75ad6c

# Server session secret (express-session). Minimum 32 random characters.
SESSION_SECRET=dev-only-session-secret-32-chars-min!!!
