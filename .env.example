# Insura Docker Compose Configuration
# ===================================
#
# This file contains all required environment variables for running Insura
# with Docker Compose. For local development, copy this file to .env and adjust
# values as needed. Never commit secrets to version control.
#
# Services:
# - web: Next.js frontend (port 3000)
# - api: NestJS backend (port 3001)
# - db: PostgreSQL database
# - redis: Redis queue/cache
# - storage: MinIO object storage (when enabled)
#
# For more information, see:
# https://github.com/insura/insura/blob/main/README.md

# Application Ports
APP_PORT=3000
WEB_PORT=3000

# Node Environment
NODE_ENV=development

# Database Configuration
POSTGRES_DB=insura
POSTGRES_USER=insura
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://insura:change-me@db:5432/insura

# Redis Configuration
REDIS_URL=redis://redis:6379

# Storage Configuration
STORAGE_ENABLED=false
DOCUMENTS_STORAGE_PATH=/app/uploads
S3_ENDPOINT=http://storage:9000
S3_BUCKET=insura
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me

# Authentication Configuration
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=insura
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

# Public OIDC setting (for frontend)
NEXT_PUBLIC_OIDC_ENABLED=false

# AI Assist Configuration (optional)
AI_ENABLED=false
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
AI_OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
AI_OPENAI_COMPAT_API_KEY=change-me
AI_OPENAI_COMPAT_MODEL=gpt-4o-mini
AI_EXTRACTION_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# Paperless Configuration (optional)
PAPERLESS_ENABLED=false
PAPERLESS_BASE_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=change-me

# Encryption and Security
# AP-02: Server-Session-Secret (express-session). Minimum 32 random characters.
# Generate with: openssl rand -hex 32
# Never commit to version control!
SETTINGS_ENCRYPTION_KEY=change-me-64-char-hex-generate-with-openssl-rand-hex-32-cmd

# AP-02: Server-Session-Secret (express-session). Minimum 32 random characters.
# Generate with: openssl rand -hex 32
# Never commit to version control!
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32-cmd