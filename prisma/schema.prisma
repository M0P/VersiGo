// VersiGo – Prisma Schema
// AP3 Scope: Insurance Policy Registry + Kernstrukturen.
// Fachliche Feature-Slices ergaenzen eigene Modelle in spaeteren
// Arbeitspaketen, ohne dieses Kern-Schema fachlich zu erweitern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Mandantentrennung -----------------------------------------------------

model Household {
  id               String   @id @default(uuid())
  name             String
  defaultCurrency  String   @default("EUR")
  createdAt        DateTime @default(now())
  archivedAt       DateTime?

  memberships             HouseholdMembership[]
  objectShares            ObjectShare[]
  integrationSettings     HouseholdIntegrationSetting[]
  policies                InsurancePolicy[]

  @@map("households")
}

// --- Identitaet (lokal + OIDC) -----------------------------------------------
//
// AP-16/ADR-007: Der Benutzername (normalisiert: lowercase, getrimmt) ist der
// eindeutige lokale Login-Identifier. Die E-Mail ist optional und KEIN
// Login-Merkmal (kein eindeutiger Index).
//
// oidcSubject ist gemaess OIDC-Spezifikation nur innerhalb eines Issuers
// eindeutig ("sub" ist issuer-scoped). Zwei unterschiedliche Provider
// koennen denselben Subject-Wert vergeben. Die Eindeutigkeit wird daher
// ausschliesslich ueber die Kombination (oidcIssuer, oidcSubject)
// hergestellt, niemals ueber oidcSubject allein. PostgreSQL behandelt NULLs
// in UNIQUE-Constraints als verschieden – daher koennen mehrere lokale
// Konten ohne OIDC-Bindung koexistieren.
//
// ADR-007: OIDC provisioniert keine Konten (kein Upsert mehr). oidcIssuer/
// oidcSubject sind NULL, bis ein Admin die Bindung setzt. Die ehemaligen
// Platzhalter-Issuer 'local'/'unknown' sind in der Migration entfernt worden.

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  role         GlobalRole  @default(USER)
  oidcIssuer   String?
  oidcSubject  String?
  email        String?
  displayName  String
  locale       String      @default("en")
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())

  credential       Credential?

  memberships      HouseholdMembership[]
  auditEvents      AuditEvent[]
  ownedPolicies    InsurancePolicy[]
  createdDocuments PolicyDocument[]
  userPreferences  UserPreference[]
  updatedGlobalSettings GlobalIntegrationSetting[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_APPROVAL
}

// AP-16/ADR-007: Globale Rollen ersetzen die alte Household-Rolle. READ_ONLY
// ist ein reiner Lesezugriff auf explizit freigegebene Objekte, USER ein
// vollwertiger Household-Teilnehmer, ADMIN hat globale Admin-Rechte.
enum GlobalRole {
  READ_ONLY
  USER
  ADMIN
}

// --- AP-14/AP-16: Lokale Benutzeranmeldung (Benutzername/Passwort) -----------
//
// Speichert das lokale Passwort eines Users (1:1). Der eindeutige
// Login-Identifier ist `users.username`; das Passwort wird mit bcrypt
// gehasht, Plaintext wird nie gespeichert (ADR-006).
//
// Credentials sind unabhaengig von OIDC-Identitaeten: Ein User kann sowohl
// ueber OIDC als auch ueber lokale Anmeldung authentifiziert werden, wenn
// beide konfiguriert sind.

model Credential {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

// --- Mandantentrennung (reine Zugehoerigkeit, ohne Berechtigungsrolle) -------
//
// AP-16: Die fruehere Household-Rolle (OWNER/ADMIN/MEMBER/VIEWER) ist durch
// die globale Rolle auf users.role ersetzt (ADR-007). Die Mitgliedschaft
// dient ausschliesslich der Mandantenisolation.

model HouseholdMembership {
  id          String   @id @default(uuid())
  householdId String
  userId      String
  createdAt   DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceShares ObjectShare[] @relation("SourceMembership")
  targetShares ObjectShare[] @relation("TargetMembership")

  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
  @@map("household_memberships")
}

// --- Objektbezogene Freigaben (technische Grundlage) ------------------------
//
// sourceUserId und targetUserId werden NICHT direkt gegen users referenziert,
// sondern ueber zusammengesetzte Fremdschluessel gegen
// household_memberships(householdId, userId). Damit erzwingt die Datenbank,
// dass beide beteiligten Nutzer tatsaechlich aktive Mitglieder desselben
// Households sind. Eine Freigabe ausserhalb der Household-Grenze ist auf
// Datenbankebene unmoeglich, nicht nur ueber Anwendungslogik geprueft.

model ObjectShare {
  id            String   @id @default(uuid())
  householdId   String
  sourceUserId  String
  targetUserId  String
  scopeType     ObjectShareScopeType
  scopeRef      String?
  permission    ObjectSharePermission
  createdAt     DateTime @default(now())

  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  sourceMembership  HouseholdMembership @relation("SourceMembership", fields: [householdId, sourceUserId], references: [householdId, userId], onDelete: Cascade)

  targetMembership  HouseholdMembership @relation("TargetMembership", fields: [householdId, targetUserId], references: [householdId, userId], onDelete: Cascade)

  @@index([householdId])
  @@index([sourceUserId])
  @@index([targetUserId])
  @@map("object_shares")
}

enum ObjectShareScopeType {
  INSURANCE
  DOCUMENT
  CATEGORY
  ALL_OWNED
}

enum ObjectSharePermission {
  READ
  WRITE
}

// --- Settings-Store fuer Integrationen und Feature-Flags --------------------
//
// Globale und Household-spezifische Werte werden in getrennten Modellen
// gefuehrt statt ueber ein optionales householdId-Feld mit zusaetzlichem
// scopeKey-Unterscheidungsmerkmal. Das schliesst eine versehentliche
// Kollision zwischen Household-Settings und globalen Settings beim
// Vergessen eines Scope-Feldes von vornherein aus.

model GlobalIntegrationSetting {
  id               String   @id @default(uuid())
  key              String   @unique
  valueEncrypted   String?
  valuePlain       String?
  isSecret         Boolean  @default(false)
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  updatedByUser User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("global_integration_settings")
}

model HouseholdIntegrationSetting {
  id             String   @id @default(uuid())
  householdId    String
  key            String
  valueEncrypted String?
  valuePlain     String?
  isSecret       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  household      Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, key])
  @@index([householdId])
  @@map("household_integration_settings")
}

// --- AP-13: User Preferences (Design-System-Farbwahl) -------------------------
//
// Speichert benutzerspezifische Praeferenzen als flache Key-Value-Paare.
// Jeder User kann beliebig viele Preferences haben; der Key ist innerhalb
// eines Users eindeutig. Werte werden als Klartext gespeichert.
// Scope: User (nicht Household) – eine Praeferenz gilt nur fuer einen User
// und wird niemals zwischen Usern geteilt.

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

// --- AP-19: Worker-Heartbeat fuer Health-/Readiness-Monitoring --------------
//
// Der Worker schreibt regelmaessig einen Heartbeat (Upsert auf workerId),
// die API liest den aktuellsten Eintrag fuer GET /ready. Enthaelt keine
// sensiblen Daten, nur Identitaet + Zeitstempel.

model WorkerHeartbeat {
  id            String   @id @default(uuid())
  workerId      String   @unique
  instanceLabel String
  startedAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}

// --- Audit-Event-Grundstruktur ----------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  actorUserId String?
  entityType String
  entityId   String
  action     String
  diffJson   Json?
  createdAt  DateTime @default(now())

  actorUser  User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_events")
}

// --- AP-03: Policy-Registry (Versicherungsverwaltung) ------------------------

model InsurancePolicy {
  id                   String              @id @default(uuid())
  householdId          String
  ownerUserId          String
  type                 InsurancePolicyType
  insurerName          String
  insurerPortalUrl     String?
  contractNumber       String
  tariffName           String?
  status               PolicyStatus        @default(ACTIVE)
  startDate            DateTime
  endDate              DateTime?
  renewalDate          DateTime?
  noticePeriod         Int?
  paymentFrequency     PaymentFrequency?
  premiumAmount        Decimal?
  deductibleAmount     Decimal?
  coverageSummaryShort String?
  source               PolicySource        @default(MANUAL)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archivedAt           DateTime?
  pinnedAt             DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerUser User      @relation(fields: [ownerUserId], references: [id])

  coveredPersons     CoveredPerson[]
  costEntries        PolicyCostEntry[]
  documents          PolicyDocument[]
  portalLinks        PortalAccountLink[]
  aiExtractionJobs   AiExtractionJob[]
  aiCoverageSummaries AiCoverageSummary[]
  paperlessTag       PolicyPaperlessTag?
  paperlessTagJobs   PaperlessTagJob[]

  @@index([householdId])
  @@index([ownerUserId])
  @@index([pinnedAt])
  @@map("insurance_policies")
}

enum InsurancePolicyType {
  HAFTPFLICHT
  HAUSRAT
  RECHTSSCHUTZ
  KFZ
  WOHNGEBAEUDE
  UNFALL
  LEBEN
  BERUFSUNFAEHIGKEIT
  RENTENVERSICHERUNG
  KRANKENVERSICHERUNG
  KRANKENVERSICHERUNG_AUSLAND
  SONSTIGE
}

enum PolicyStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PolicySource {
  MANUAL
  AI_EXTRACTED
  IMPORTED
}

model CoveredPerson {
  id           String   @id @default(uuid())
  policyId     String
  personName   String
  // BugFix-22: insured subjects are persons or objects (car, house, ...).
  subjectType  CoveredSubjectType @default(PERSON)
  // BugFix-22: the relation is optional (an object has no relation).
  relationType String?
  birthDate    DateTime?

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("covered_persons")
}

/**
 * BugFix-22: kind of an insured subject. `PERSON` is the default so that all
 * pre-existing rows remain valid without data migration.
 */
enum CoveredSubjectType {
  PERSON
  OBJECT
}

model PolicyCostEntry {
  id            String           @id @default(uuid())
  policyId      String
  validFrom     DateTime
  validTo       DateTime?
  // BugFix-22: at least one of gross/net is required; the amount basis of all
  // calculations is "gross if set, otherwise net".
  grossAmount   Decimal?
  netAmount     Decimal?
  frequency     PaymentFrequency
  bookingSource String?
  note          String?
  // AP-24 (§4.2): the document this entry was derived from. Set when the
  // entry was created from the billing-document sidebar (with or without AI
  // support) so duplicates can be spotted; null for manually typed entries.
  sourceDocumentId String?
  createdAt     DateTime         @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sourceDocument PolicyDocument? @relation("CostEntrySourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@index([sourceDocumentId])
  @@map("policy_cost_entries")
}

model PolicyDocument {
  id               String               @id @default(uuid())
  policyId         String
  storageType      DocumentStorageType  @default(INTERNAL)
  fileName         String
  mimeType         String?
  fileSize         Int?
  checksum         String?
  storageRef       String?
  documentDate     DateTime?
  category         String?
  documentVersion  Int                  @default(1)
  createdByUserId  String?
  uploadedAt       DateTime             @default(now())
  aiProcessingExcluded Boolean     @default(false)
  archivedAt           DateTime?

  // AP-22: unabhaengige Herkunftsinformationen einer Dokumentzuordnung.
  // Beide Quellen koennen gleichzeitig vorliegen (z.B. manuell verlinktes
  // Dokument, das zusaetzlich den Versicherungs-Tag traegt) – deshalb zwei
  // unabhaengige Booleans statt eines exklusiven Enums. INTERNAL-Uploads
  // haben beide Felder auf false.
  linkOriginManual  Boolean @default(false)
  linkOriginTag     Boolean @default(false)

  // AP-22: Status der externen Tag-Zuweisung fuer manuell verlinkte
  // Paperless-Dokumente (outbox-Konsistenz: lokal verlinkt, extern noch
  // nicht bestaetigt). NULL = keine Tag-Zuweisung ausstehend/erforderlich.
  taggingStatus    PaperlessTaggingStatus?
  taggingErrorCode String?

  // AP-24 (§2): Dokumentklasse je Versicherungs-Zuordnung. Bestehende
  // Dokumente erhalten bei der Migration UNCLASSIFIED; es erfolgt keine
  // automatische inhaltliche Klassifikation. Die Tag-Synchronisation
  // schreibt dieses Feld nie an (die Klassifikation ueberlebt den Abgleich).
  documentClass    DocumentClass @default(UNCLASSIFIED)

  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // AP-24 (§4.2): Kosteneintraege, die aus diesem Dokument abgeleitet wurden.
  costEntrySources PolicyCostEntry[] @relation("CostEntrySourceDocument")

  @@index([policyId])
  @@index([policyId, checksum])
  @@map("policy_documents")
}

// AP-22: Zuordnung eines Paperless-Versicherungs-Tags zu einer Versicherung.
// Der externe Tag wird ueber seine ID referenziert (stabil bei Umbenennung);
// der Name ist nur ein Anzeige-Cache. configVersion schuetzt vor veralteten
// Queue-Jobs: Jeder Job fuehrt die zum Zeitpunkt der Einreichung geltende
// Version mit und wird vor der Verarbeitung gegen den aktuellen Stand
// geprueft. syncErrorCode ist bewusst nicht sensitiv (kein Token/Inhalt).
model PolicyPaperlessTag {
  id               String   @id @default(uuid())
  policyId         String   @unique
  // AP-22: Referenz auf die zum Konfigurationszeitpunkt verwendete
  // Paperless-Verbindung (effektive PAPERLESS_URL, ohne Zugangsdaten).
  // Zeigt der Admin spaeter auf einen anderen Paperless-Server, werden
  // Jobs als veraltet erkannt und die Zuordnung wird nicht stillschweigend
  // auf einen fremden Server uebertragen.
  connectionRef    String?
  paperlessTagId   Int
  paperlessTagName String?
  configVersion    Int      @default(1)
  lastSyncedAt     DateTime?
  syncStatus       SyncStatus @default(PENDING)
  syncErrorCode    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([paperlessTagId])
  @@map("policy_paperless_tags")
}

// AP-22: Dauerhafte Job-Erfassung (Outbox-Aequivalent) fuer Paperless-
// Tagging-Auftraege. Die Zeile wird IN DERSELBEN Transaktion wie die
// Datenbank-Aenderung angelegt und anschliessend in BullMQ eingereiht –
// zwischen DB-Aenderung und Job-Erstellung geht kein Auftrag verloren.
// Ein fehlgeschlagener Enqueue bleibt PENDING und wird erneut angestossen.
model PaperlessTagJob {
  id            String   @id @default(uuid())
  policyId      String
  documentId    String?
  kind          PaperlessTagJobKind
  status        AiJobStatus @default(PENDING)
  configVersion Int
  retryCount    Int      @default(0)
  maxRetries    Int      @default(3)
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  // AP-24 (§1.1): Fortschritt eines SYNC_POLICY-Laufs für die Oberfläche.
  // `totalCount` bleibt NULL, solange die Gesamtzahl nicht feststeht (der
  // Remote-Liste entnommen) – die Oberfläche zeigt dann einen unbestimmten
  // Balken mit dem bereits verarbeiteten Zwischenstand statt eines
  // vorgetäuschten Prozentwerts. Die Zähler sind NICHT sensitiv: sie
  // enthalten keine Dokumentinhalte oder Zugangsdaten.
  processedCount Int      @default(0)
  totalCount     Int?
  addedCount     Int      @default(0)
  removedCount   Int      @default(0)
  unchangedCount Int      @default(0)

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, status])
  @@index([status])
  @@map("paperless_tag_jobs")
}

enum PaperlessTagJobKind {
  SYNC_POLICY
  TAG_DOCUMENT
}

// AP-22: Ergebnis der externen Tag-Zuweisung an ein manuell verlinktes
// Dokument. PENDING = lokal verlinkt, extern noch nicht bestaetigt.
enum PaperlessTaggingStatus {
  PENDING
  APPLIED
  FAILED
}

// BugFix-07 (Code-Review): Race-feste Deduplizierung von Paperless-Links.
// Migration 20260806140000_bugfix07_paperless_link_dedupe legt einen
// PARTIELLEN Unique-Index an, den Prisma nicht im Schema abbilden kann:
//   CREATE UNIQUE INDEX "policy_documents_policyId_storageRef_key"
//     ON "policy_documents" ("policyId", "storageRef")
//     WHERE "archivedAt" IS NULL AND "storageType" = 'PAPERLESS_LINK';
// Er garantiert max. einen aktiven Link pro (policyId, storageRef) und
// laesst ein erneutes Verknuepfen nach dem Archivieren zu.

enum DocumentStorageType {
  INTERNAL
  PAPERLESS_LINK
}

// AP-24 (§2): feste Dokumentklassen. CONTRACT und BILLING sind verbindlich
// (sie traegen die waehlbaren Vertragsdokumente der KI-Zusammenfassung
// beziehungsweise die Abrechnungsliste der Kostenansicht); die uebrigen
// Klassen sind Vorschlaege. Die Klassifikation gilt JE Versicherungs-
// Zuordnung (PolicyDocument), nicht externes Dokument: dieselbe Paperless-
// Quelle kann bei einer Versicherung eine Rechnung und bei einer anderen
// eine Korrespondenz sein. Sie wird nie von der Tag-Synchronisation
// ueberschrieben.
enum DocumentClass {
  CONTRACT
  BILLING
  CORRESPONDENCE
  CLAIM
  OTHER
  UNCLASSIFIED
}

// AP-18: Portal-Connectoren. Der Kernumfang umfasst Deeplinks und
// Zugangshinweise (accessHint). credentialsEncrypted speichert optionale
// Portal-Zugangsdaten ausschliesslich AES-256-GCM-verschluesselt
// (EncryptionPort, nie Klartext). connectorKey referenziert ein optionales
// Connector-Plugin (z. B. experimenteller Mailbox-/Dokumentenabruf);
// ein nicht verfuegbares Plugin beeintraechtigt den Portal-Link nicht.
model PortalAccountLink {
  id                  String      @id @default(uuid())
  policyId            String
  providerKey         String
  portalUrl           String?
  accessHint          String?
  usernameHint        String?
  connectorKey        String?
  credentialsEncrypted String?
  mailboxCapability   Boolean     @default(false)
  lastSyncAt          DateTime?
  syncStatus          SyncStatus  @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("portal_account_links")
}

enum SyncStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

// --- AP-09: AI Assist (optionale AI-Provider-Adapter) ------------------------

enum AiJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model AiExtractionJob {
  id                 String       @id @default(uuid())
  policyId           String
  providerKey        String
  model              String?
  status             AiJobStatus  @default(PENDING)
  inputDocumentRef   String?
  extractedFieldsJson Json?
  confidenceJson     Json?
  errorMessage       String?
  retryCount         Int          @default(0)
  maxRetries         Int          @default(3)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
  @@map("ai_extraction_jobs")
}

model AiCoverageSummary {
  id                   String   @id @default(uuid())
  policyId             String
  providerKey          String
  model                String?
  summaryMarkdown      String
  // AP-24 (§3.2): structured summary (Variante A). New summaries store the
  // validated JSON document here and keep `summaryMarkdown` as a plain-text
  // rendering for consumers that only know the old shape. Rows written before
  // AP-24 keep `summaryJson = null` and are rendered as legacy Markdown.
  summaryJson          Json?
  sourceDocumentRefsJson Json?
  createdAt            DateTime @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("ai_coverage_summaries")
}
