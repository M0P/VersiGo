{
  "name": "@versigo/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/apps/worker/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@versigo/foundation": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "axios": "^1.18.1",
    "bullmq": "^5.34.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "ts-node-dev": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
