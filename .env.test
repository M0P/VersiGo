# ============================================================
# VersiGo – Test Environment (Ports 2478/2479)
# ============================================================

# --- Application -------------------------------------------------
NODE_ENV=development
APP_PORT=2479
WEB_PORT=2478

# Public API base URL for the browser (Next.js build-time inlined)
NEXT_PUBLIC_API_BASE_URL=http://localhost:2479

# Next.js dev server: allowed origins for HMR/dev requests
NEXT_ALLOWED_DEV_ORIGINS=

# AP-16: Express "trust proxy"
TRUST_PROXY=false

# AP-20: Secure-Flag des Session-Cookies
COOKIE_SECURE=

# AP-16: Erlaubte Browser-Origins fuer CORS
CORS_ORIGINS=http://localhost:2478

# --- PostgreSQL --------------------------------------------------
POSTGRES_DB=versigo
POSTGRES_USER=versigo
POSTGRES_PASSWORD=test-password-123
DATABASE_URL=postgresql://versigo:test-password-123@db:5432/versigo

# --- Redis -------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Document Storage --------------------------------------------
STORAGE_ENABLED=false
DOCUMENTS_STORAGE_PATH=/data/uploads

# Optional MinIO/S3 storage
S3_ENDPOINT=http://storage:9000
S3_BUCKET=versigo
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-change-me

# --- Local Username/Password Authentication ----------------------
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_MAX_ATTEMPTS=5
LOCAL_AUTH_RATE_LIMIT_WINDOW_MS=900000

# Initial local administrator
LOCAL_ADMIN_USERNAME=localadmin
LOCAL_ADMIN_PASSWORD=TestAdmin123!

# --- OIDC Authentication (optional) -------------------------------
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=versigo
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_URL=http://localhost:2479/auth/callback

# --- AI Assist (optional) ----------
AI_ENABLED=false
AI_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3
AI_OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
AI_OPENAI_COMPAT_API_KEY=change-me
AI_OPENAI_COMPAT_MODEL=gpt-4o-mini
AI_EXTRACTION_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# --- Paperless-ngx (optional) -------
PAPERLESS_ENABLED=false
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=change-me

# --- Worker Health (AP-19) ------------------------------------------
WORKER_HEALTH_PORT=3100
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TIMEOUT_MS=45000

# --- Secrets (REQUIRED - generate your own!) -----------------------
SETTINGS_ENCRYPTION_KEY=6fb08ca5c2594034b97f2a50e3011699c5a791bd3711d726092fec455d75ad6c
SESSION_SECRET=test-session-secret-32-chars-min!!!
